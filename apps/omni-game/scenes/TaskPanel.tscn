[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/task_panel.gd" id="1_task"]

[node name="TaskPanel" type="PanelContainer"]
custom_minimum_size = Vector2(900, 650)
script = ExtResource("1_task")

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 26
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 26

[node name="Content" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 14

[node name="Header" type="HBoxContainer" parent="Margin/Content"]
theme_override_constants/separation = 12

[node name="BackButton" type="Button" parent="Margin/Content/Header"]
unique_name_in_owner = true
text = "← 伙伴列表"

[node name="AgentName" type="Label" parent="Margin/Content/Header"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 26
text = "伙伴"

[node name="NewSessionButton" type="Button" parent="Margin/Content/Header"]
unique_name_in_owner = true
text = "新任务"

[node name="SessionLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
text = "任务存档：-"

[node name="Transcript" type="RichTextLabel" parent="Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 350)
size_flags_vertical = 3
bbcode_enabled = false
fit_content = false
scroll_active = true
text = "伙伴的输出会显示在这里。"

[node name="TaskInput" type="TextEdit" parent="Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 100)
placeholder_text = "描述一件要让伙伴完成的事情……"
wrap_mode = 1

[node name="Actions" type="HBoxContainer" parent="Margin/Content"]
alignment = 2
theme_override_constants/separation = 10

[node name="StatusLabel" type="Label" parent="Margin/Content/Actions"]
unique_name_in_owner = true
size_flags_horizontal = 3
text = "伙伴已经准备好了。"
autowrap_mode = 2

[node name="CancelButton" type="Button" parent="Margin/Content/Actions"]
unique_name_in_owner = true
disabled = true
text = "取消"

[node name="RunButton" type="Button" parent="Margin/Content/Actions"]
unique_name_in_owner = true
text = "做事情"
