[sub_resource type="Shader" id="FrameClip"]
code = "shader_type canvas_item;
// The generated paper is opaque; clip only its outside rounded corners.
// Texture-space coordinates also preserve the shape under nine-slice resizing.
// The current 1413px source has an 18px outer radius; scale with import resolution.
void fragment() {
    vec2 extent = 1.0 / TEXTURE_PIXEL_SIZE;
    float radius = extent.x * (18.0 / 1413.0);
    vec2 q = abs(UV * extent - extent * 0.5) - (extent * 0.5 - vec2(radius + 1.0));
    float distance_to_corner = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
    COLOR.a *= 1.0 - smoothstep(-0.5, 0.5, distance_to_corner);
}
"

[sub_resource type="ShaderMaterial" id="FrameMaterial"]
shader = SubResource("FrameClip")

