{
  "name": "omni-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "tsx packages/cli/src/index.ts",
    "dev:coding": "tsx packages/cli/src/index.ts run coding",
    "dev:financial-analysis": "tsx packages/cli/src/index.ts run financial-analysis",
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm run clean && tsc -b --force packages/core packages/tools packages/models packages/app agents/coding agents/financial-analysis packages/cli",
    "typecheck": "tsc -b packages/core packages/tools packages/models packages/app agents/coding agents/financial-analysis packages/cli && tsc -p packages/core/evals/checkpointSummary/tsconfig.json && tsc -p agents/coding/evals/clarificationRouting/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:checkpoint": "tsx packages/core/evals/checkpointSummary/runner.ts",
    "eval:clarification": "tsx agents/coding/evals/clarificationRouting/runner.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:cli": "node scripts/build-cli-distribution.mjs",
    "pack:cli": "node scripts/pack-cli-distribution.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
